<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <!-- Under Rosetta, libffi (every PyObjC callback) cannot map executable memory inside the hardened
         runtime without this, and `import Foundation` never finishes. Native arm64 needs nothing. -->
    <key>com.apple.security.cs.allow-unsigned-executable-memory</key>
    <true/>
    <!-- The local audio experiment: the hardened runtime refuses the microphone without this, and
         macOS never even asks. -->
    <key>com.apple.security.device.audio-input</key>
    <true/>
</dict>
</plist>
